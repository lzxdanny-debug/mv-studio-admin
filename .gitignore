# ── 依赖 ──────────────────────────────────────────────────────────────────────
node_modules/
.pnpm-store/
.pnpm/

# ── 构建产物 ──────────────────────────────────────────────────────────────────
dist/
build/
out/
.next/
.open-next/
.wrangler/
.turbo/
*.tsbuildinfo

# ── 环境变量（含密钥，绝不提交） ─────────────────────────────────────────────
.env
.env.local
.env.*.local
.env.development
.env.staging
# .env.production 仅含 NEXT_PUBLIC_*（无密钥），须入库供 Cloudflare Builds 内联
# 保留示例 / 生产公开配置
!.env.example
!.env.local.example
!.env.production

# ── 日志 ─────────────────────────────────────────────────────────────────────
*.log
*.log.*
logs/
# 例外：admin 后台「系统日志」前端页面路径恰好叫 logs（不是日志输出目录）
!src/app/admin/logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ── 测试 & 覆盖率 ─────────────────────────────────────────────────────────────
coverage/
.nyc_output/

# ── 编辑器 & 系统 ─────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
.idea/
.vscode/settings.json
.vscode/launch.json
*.swp
*.swo
.cursor/

# ── 临时 / 调试文件 ───────────────────────────────────────────────────────────
*.local
tmp/
temp/
