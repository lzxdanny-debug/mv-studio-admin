# MV Studio Admin - 开发环境配置示例
# 复制为 .env.local 并填写真实值

# API 基础 URL（指向 mv-studio-api）
NEXT_PUBLIC_API_URL=http://localhost:4001/api

# 站点 URL
NEXT_PUBLIC_SITE_URL=http://localhost:4002

# ── 局域网同事访问（可选）────────────────────────────────────
# 复制为 .env.development.local，并填本机 IP：ipconfig getifaddr en0
# DEV_LAN_HOST=192.168.0.186
# NEXT_PUBLIC_API_URL=http://192.168.0.186:4001/api
# 同时需 pnpm dev 监听 0.0.0.0（package.json 已配置 -H 0.0.0.0）
